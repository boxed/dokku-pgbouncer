#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"

PLUGIN_BASE_PATH="${PLUGIN_BASE_PATH:-/var/lib/dokku/plugins}"

case "$1" in
  pgbouncer:intercept-db)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    [[ -z "$3" ]] && dokku_log_fail "Please specify a postgres service name"
    MAIN_APP="$2"
    DB_SERVICE="$3"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"

    # Get DATABASE_URL from the main app (set by postgres:link)
    DATABASE_URL=$(dokku config:get "$MAIN_APP" DATABASE_URL 2>/dev/null || true)
    [[ -z "$DATABASE_URL" ]] && dokku_log_fail "No DATABASE_URL found on $MAIN_APP. Link a postgres service first."

    # Parse DATABASE_URL: postgres://USER:PASSWORD@HOST:PORT/DB
    # Strip the scheme
    URL_BODY="${DATABASE_URL#postgres://}"
    URL_BODY="${URL_BODY#postgresql://}"

    USERINFO="${URL_BODY%%@*}"
    HOSTINFO="${URL_BODY#*@}"

    DB_USER="${USERINFO%%:*}"
    DB_PASSWORD="${USERINFO#*:}"

    HOSTPORT="${HOSTINFO%%/*}"
    DB_NAME="${HOSTINFO#*/}"
    # Strip query params from DB_NAME
    DB_NAME="${DB_NAME%%\?*}"

    DB_HOST="${HOSTPORT%%:*}"
    DB_PORT="${HOSTPORT#*:}"
    [[ "$DB_PORT" == "$DB_HOST" ]] && DB_PORT="5432"

    dokku_log_info1 "Creating pgbouncer app: $BOUNCER_APP"
    dokku apps:create "$BOUNCER_APP"

    dokku_log_info1 "Setting pgbouncer config"
    dokku config:set --no-restart "$BOUNCER_APP" \
      DATABASES_HOST="$DB_HOST" \
      DATABASES_USER="$DB_USER" \
      DATABASES_PASSWORD="$DB_PASSWORD" \
      DATABASES_PORT="$DB_PORT" \
      DATABASES_DB="$DB_NAME"

    dokku_log_info1 "Deploying pgbouncer image"
    dokku git:from-image "$BOUNCER_APP" pgbouncer/pgbouncer:latest

    # Store the service name so destroy can auto-relink
    dokku config:set --no-restart "$BOUNCER_APP" DOKKU_PGBOUNCER_DB_SERVICE="$DB_SERVICE"

    # Capture all DOKKU_POSTGRES_* vars before unlinking
    SERVICE_UPPER=$(echo "$DB_SERVICE" | tr '[:lower:]-' '[:upper:]_')
    PREFIX="DOKKU_POSTGRES_${SERVICE_UPPER}_"
    SAVED_VARS=$(dokku config:show "$MAIN_APP" | grep "^${PREFIX}" || true)

    # Unlink postgres so it stops owning these vars
    dokku_log_info1 "Unlinking postgres service $DB_SERVICE from $MAIN_APP"
    dokku postgres:unlink "$DB_SERVICE" "$MAIN_APP" --no-restart

    # Restore the saved vars, overriding connectivity ones to point to pgbouncer
    BOUNCER_HOST="${BOUNCER_APP}.web"
    BOUNCER_PORT="6432"

    # Build config:set args from saved vars
    CONFIG_ARGS=()
    while IFS=: read -r key value; do
      key=$(echo "$key" | xargs)
      value=$(echo "$value" | sed 's/^ *//')
      [[ -z "$key" ]] && continue
      CONFIG_ARGS+=("${key}=${value}")
    done <<< "$SAVED_VARS"

    # Override the connectivity vars and DATABASE_URL to point through pgbouncer
    CONFIG_ARGS+=(
      "DATABASE_URL=postgres://${DB_USER}@${BOUNCER_HOST}:${BOUNCER_PORT}/${DB_NAME}"
      "${PREFIX}PORT_5432_TCP_ADDR=${BOUNCER_HOST}"
      "${PREFIX}PORT_5432_TCP_PORT=${BOUNCER_PORT}"
      "${PREFIX}PORT_5432_TCP=tcp://${BOUNCER_HOST}:${BOUNCER_PORT}"
      "${PREFIX}PORT=tcp://${BOUNCER_HOST}:${BOUNCER_PORT}"
    )

    dokku_log_info1 "Updating $MAIN_APP to use pgbouncer"
    dokku config:set "$MAIN_APP" "${CONFIG_ARGS[@]}"

    dokku_log_info1 "Done! $MAIN_APP is now using pgbouncer via $BOUNCER_APP"
    ;;

  pgbouncer:remove-intercept-db)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    MAIN_APP="$2"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"

    # Retrieve the db service name before destroying
    DB_SERVICE=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_DB_SERVICE 2>/dev/null || true)

    dokku_log_info1 "Destroying pgbouncer app: $BOUNCER_APP"
    dokku apps:destroy "$BOUNCER_APP" --force

    if [[ -n "$DB_SERVICE" ]]; then
      dokku_log_info1 "Restoring direct database connection for $MAIN_APP"
      dokku postgres:link "$DB_SERVICE" "$MAIN_APP"
    else
      dokku_log_warn "Could not determine postgres service name. Restore DATABASE_URL manually:"
      dokku_log_warn "  dokku postgres:link <service> $MAIN_APP"
    fi
    ;;

  pgbouncer:info)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    MAIN_APP="$2"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"

    dokku config:show "$BOUNCER_APP"
    ;;

  help | pgbouncer:help)
    help_content_func() {
      declare desc="return pgbouncer plugin help content"
      cat <<EOF
    pgbouncer:intercept-db <app> <service>, Intercept an app's db connection through pgbouncer
    pgbouncer:remove-intercept-db <app>, Remove pgbouncer and restore direct db connection
    pgbouncer:info <app>, Show pgbouncer config for an app
EOF
    }
    if [[ $1 == "pgbouncer:help" ]]; then
      echo -e "Usage: dokku pgbouncer[:COMMAND]"
      echo ""
      echo -e "Manage pgbouncer connection pooling"
      echo ""
      echo -e "Additional commands:"
      help_content_func | sort | column -c2 -t -s,
    else
      help_content_func
    fi
    ;;

  *)
    exit "$DOKKU_NOT_IMPLEMENTED_EXIT"
    ;;
esac
