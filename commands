#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/functions"

case "$1" in
  pgbouncer:connect)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    [[ -z "$3" ]] && dokku_log_fail "Please specify a postgres service name"
    MAIN_APP="$2"
    DB_SERVICE="$3"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"

    # Get DATABASE_URL from the main app (set by postgres:link)
    DATABASE_URL=$(dokku config:get "$MAIN_APP" DATABASE_URL) || dokku_log_fail "Failed to read DATABASE_URL from $MAIN_APP"
    [[ -z "$DATABASE_URL" ]] && dokku_log_fail "No DATABASE_URL found on $MAIN_APP. Link a postgres service first."

    # Parse DATABASE_URL: postgres://USER:PASSWORD@HOST:PORT/DB
    URL_BODY="${DATABASE_URL#postgres://}"
    URL_BODY="${URL_BODY#postgresql://}"
    [[ "$URL_BODY" == "$DATABASE_URL" ]] && dokku_log_fail "DATABASE_URL on $MAIN_APP is not a postgres:// URL"
    [[ "$URL_BODY" != *@* ]] && dokku_log_fail "DATABASE_URL on $MAIN_APP has no credentials part"

    # Split on the LAST @ so a password containing @ still parses
    USERINFO="${URL_BODY%@*}"
    HOSTINFO="${URL_BODY##*@}"

    # pgbouncer opens the server-side connection itself, so it needs a password;
    # a userinfo without one cannot be made to work by this plugin.
    [[ "$USERINFO" == *:* ]] || dokku_log_fail "DATABASE_URL on $MAIN_APP has no password (expected postgres://user:password@host:port/dbname). Pgbouncer needs it to open connections to postgres."
    DB_USER=$(urldecode "${USERINFO%%:*}") || dokku_log_fail "Failed to decode the user in DATABASE_URL"
    DB_PASSWORD=$(urldecode "${USERINFO#*:}") || dokku_log_fail "Failed to decode the password in DATABASE_URL"

    [[ "$HOSTINFO" == */* ]] || dokku_log_fail "DATABASE_URL on $MAIN_APP has no database name (expected postgres://user:password@host:port/dbname)"
    HOSTPORT="${HOSTINFO%%/*}"
    DB_NAME_ENCODED="${HOSTINFO#*/}"
    DB_QUERY=""
    if [[ "$DB_NAME_ENCODED" == *\?* ]]; then
      DB_QUERY="${DB_NAME_ENCODED#*\?}"
      DB_NAME_ENCODED="${DB_NAME_ENCODED%%\?*}"
    fi
    # The path is percent-encoded like the userinfo, so pgbouncer must be given
    # the decoded name. The encoded form is kept for building PGBOUNCER_URL.
    DB_NAME=$(urldecode "$DB_NAME_ENCODED") || dokku_log_fail "Failed to decode the database name in DATABASE_URL"

    if [[ "$HOSTPORT" == \[* ]]; then
      # IPv6 literal, e.g. [::1]:5432
      DB_HOST="${HOSTPORT%%]*}"
      DB_HOST="${DB_HOST#\[}"
      DB_PORT="${HOSTPORT##*]}"
      DB_PORT="${DB_PORT#:}"
    else
      DB_HOST="${HOSTPORT%%:*}"
      DB_PORT="${HOSTPORT#*:}"
      [[ "$DB_PORT" == "$HOSTPORT" ]] && DB_PORT=""
    fi
    [[ -z "$DB_PORT" ]] && DB_PORT="5432"
    # The port lands on the same unquoted pgbouncer.ini line as the values
    # checked by assert_ini_safe below, so it needs a guard of its own.
    [[ "$DB_PORT" =~ ^[0-9]+$ ]] || dokku_log_fail "DATABASE_URL on $MAIN_APP has a non-numeric port '$DB_PORT'"

    [[ -z "$DB_USER" ]] && dokku_log_fail "Failed to parse user from DATABASE_URL"
    [[ -z "$DB_PASSWORD" ]] && dokku_log_fail "DATABASE_URL on $MAIN_APP has an empty password. Pgbouncer needs it to open connections to postgres."
    [[ -z "$DB_HOST" ]] && dokku_log_fail "Failed to parse host from DATABASE_URL"
    [[ -z "$DB_NAME" ]] && dokku_log_fail "Failed to parse database name from DATABASE_URL"

    # All three are written into pgbouncer.ini unquoted, and all three are
    # url-decoded above, so any of them can carry characters that break it.
    assert_ini_safe "database password" "$DB_PASSWORD"
    assert_ini_safe "database user" "$DB_USER"
    assert_ini_safe "database name" "$DB_NAME"

    # Credentials come from DATABASE_URL but the postgres host comes from the
    # service argument, so a wrong service silently pairs one service's
    # hostname with another's credentials. dokku-postgres links its services
    # under 'dokku-postgres-<service>'; the container name form is accepted too
    # for hand-written URLs.
    EXPECTED_DB_HOST="$(service_dns_host "$DB_SERVICE")"
    if [[ "$DB_HOST" != "$EXPECTED_DB_HOST" && "$DB_HOST" != "dokku.postgres.${DB_SERVICE}" ]]; then
      # Both naming forms have to fail hard, or a mismatch slips through as a
      # warning for whichever form the check happens not to recognise.
      if [[ "$DB_HOST" == dokku-postgres-* || "$DB_HOST" == dokku.postgres.* ]]; then
        dokku_log_fail "DATABASE_URL on $MAIN_APP points at '$DB_HOST', but you asked to connect service '$DB_SERVICE' (expected '$EXPECTED_DB_HOST'). Those credentials belong to a different postgres service."
      fi
      dokku_log_warn "DATABASE_URL host '$DB_HOST' does not look like postgres service '$DB_SERVICE' (expected '$EXPECTED_DB_HOST'); continuing, but verify the credentials belong to $DB_SERVICE"
    fi

    if [[ -n "$DB_QUERY" ]]; then
      dokku_log_warn "Ignoring the query string '?${DB_QUERY}' on DATABASE_URL: it is not applied to the pgbouncer connection."
      case "$DB_QUERY" in
        *sslmode=verify* | *sslmode=require*)
          dokku_log_warn "DATABASE_URL asks for TLS to postgres, but traffic to pgbouncer is plaintext on the private docker network and this plugin does not configure TLS on either leg."
          ;;
      esac
    fi

    BOUNCER_PORT="6432"
    BOUNCER_HOST="${BOUNCER_APP}.web"
    # BOUNCER_HOST becomes a docker network alias, i.e. a single DNS label.
    # Docker rejects the alias outright past 63 characters, which would fail
    # much later and far from the cause.
    [[ ${#BOUNCER_HOST} -gt 63 ]] && dokku_log_fail "The pgbouncer hostname '$BOUNCER_HOST' is ${#BOUNCER_HOST} characters, over the 63-character DNS limit. Use an app name of at most $((63 - ${#BOUNCER_HOST} + ${#MAIN_APP})) characters."

    # The postgres container must exist before we can attach it or borrow its
    # image for the probe below.
    docker inspect --format '{{.Id}}' "dokku.postgres.${DB_SERVICE}" >/dev/null 2>&1 ||
      dokku_log_fail "No container 'dokku.postgres.${DB_SERVICE}' found. Does postgres service '$DB_SERVICE' exist and has it been started?"

    NETWORK_NAME="pgbouncer-${MAIN_APP}"

    # post-start-network is single-valued: overwriting another value would
    # silently detach whatever set it (e.g. another app's pgbouncer) on the next
    # postgres restart. This is a pure read and it runs before anything is
    # created, claimed or released, so a conflict cannot leave a half-applied
    # setup behind — in particular it must precede the detach of a previous
    # service below, or naming a taken service would tear down this app's
    # working pgbouncer and then abort.
    CURRENT_PSN=$(dokku postgres:info "$DB_SERVICE" --post-start-network 2>/dev/null) || {
      CURRENT_PSN=""
      dokku_log_warn "Could not read post-start-network of $DB_SERVICE, assuming it is unset"
    }
    if [[ -n "$CURRENT_PSN" && "$CURRENT_PSN" != "$NETWORK_NAME" ]]; then
      dokku_log_fail "Postgres service $DB_SERVICE already has post-start-network '$CURRENT_PSN' (likely another app's pgbouncer). A postgres service can only back one pgbouncer at a time."
    fi

    # Create a shared network for the app, pgbouncer, and postgres
    if dokku network:exists "$NETWORK_NAME" >/dev/null 2>&1; then
      dokku_log_info1 "Network $NETWORK_NAME already exists"
    else
      dokku_log_info1 "Creating network: $NETWORK_NAME"
      dokku network:create "$NETWORK_NAME" || dokku_log_fail "Failed to create network $NETWORK_NAME"
    fi

    # The bouncer app name is derived by convention, so an app of that name is
    # not necessarily ours. Overwriting a stranger's app would replace whatever
    # is deployed there, so require the marker set at the end of this command.
    PREVIOUS_SERVICE=""
    PREVIOUS_NETWORK=""
    if dokku apps:exists "$BOUNCER_APP" >/dev/null 2>&1; then
      PREVIOUS_SERVICE=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_DB_SERVICE 2>/dev/null || true)
      PREVIOUS_NETWORK=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_NETWORK 2>/dev/null || true)
      [[ -z "$PREVIOUS_NETWORK" ]] && PREVIOUS_NETWORK="$NETWORK_NAME"
      if [[ -n "$PREVIOUS_SERVICE" ]]; then
        dokku_log_info1 "App $BOUNCER_APP already exists, reusing it"
      else
        # No marker. Only safe to take over if nothing is deployed there.
        BOUNCER_DEPLOYED=$(dokku ps:report "$BOUNCER_APP" --deployed 2>/dev/null) || BOUNCER_DEPLOYED="unknown"
        [[ "$BOUNCER_DEPLOYED" != "false" ]] && dokku_log_fail "App $BOUNCER_APP exists, has a deployment, and was not created by this plugin (no DOKKU_PGBOUNCER_DB_SERVICE set). Refusing to overwrite it. Remove it first if it is unused: dokku apps:destroy $BOUNCER_APP"
        dokku_log_info1 "App $BOUNCER_APP exists but has nothing deployed, adopting it"
      fi
    else
      dokku_log_info1 "Creating pgbouncer app: $BOUNCER_APP"
      dokku apps:create "$BOUNCER_APP" || dokku_log_fail "Failed to create app $BOUNCER_APP"
    fi

    # Pgbouncer speaks the postgres protocol; it must not be reachable through nginx
    dokku_log_info1 "Disabling the http proxy for $BOUNCER_APP"
    dokku proxy:disable "$BOUNCER_APP" || dokku_log_warn "Failed to disable proxy for $BOUNCER_APP, continuing"

    # Read the main app's networks before any of the mutations below, so the
    # rollback helpers can restore exactly what was found.
    # Merge with any attach-post-create networks the app already has instead of clobbering them.
    ORIGINAL_MAIN_APP_NETWORKS=$(dokku network:report "$MAIN_APP" --network-attach-post-create) || dokku_log_fail "Failed to read attach-post-create networks of $MAIN_APP"

    # Each flag records a mutation that the rollback helpers know how to undo.
    # They stay false when a step was already in the desired state, so a plain
    # re-run that fails undoes nothing it did not itself change.
    MAIN_APP_NETWORK_ADDED=false
    MAIN_APP_RESTARTED=false
    PREVIOUS_PSN_CLEARED=false
    PREVIOUS_CONTAINER_DETACHED=false
    NEW_PSN_SET=false
    NEW_CONTAINER_CONNECTED=false

    # Undo everything this command published on the main app. Used on every
    # failure after this point so a half-applied setup is not left behind for
    # whoever deploys the app next.
    rollback_main_app() {
      dokku config:unset --no-restart "$MAIN_APP" PGBOUNCER_URL PGBOUNCER_HOST PGBOUNCER_PORT || dokku_log_warn "Failed to unset pgbouncer env vars on $MAIN_APP"
      if [[ "$MAIN_APP_NETWORK_ADDED" == "true" ]]; then
        # shellcheck disable=SC2086
        dokku network:set "$MAIN_APP" attach-post-create $ORIGINAL_MAIN_APP_NETWORKS || dokku_log_warn "Failed to restore attach-post-create networks of $MAIN_APP"
      fi
      # Only once the app has been restarted with PGBOUNCER_URL in its
      # environment: unsetting the config alone would leave the running
      # containers talking to a pgbouncer this run is abandoning.
      if [[ "$MAIN_APP_RESTARTED" == "true" ]]; then
        dokku ps:restart "$MAIN_APP" || dokku_log_warn "Failed to restart $MAIN_APP during rollback; its containers may still be using PGBOUNCER_URL"
      fi
    }

    # Undo the postgres-side changes. post-start-network is single-valued and
    # the docker attachment is shared, so a failed run must leave neither the
    # new service claimed nor a previous one released.
    rollback_services() {
      if [[ "$NEW_CONTAINER_CONNECTED" == "true" ]] && container_on_network "dokku.postgres.${DB_SERVICE}" "$NETWORK_NAME"; then
        docker network disconnect "$NETWORK_NAME" "dokku.postgres.${DB_SERVICE}" || dokku_log_warn "Failed to detach $DB_SERVICE from network $NETWORK_NAME during rollback"
      fi
      if [[ "$NEW_PSN_SET" == "true" ]]; then
        dokku postgres:set "$DB_SERVICE" post-start-network "" || dokku_log_warn "Failed to clear post-start-network on $DB_SERVICE during rollback; it may now refuse to back another pgbouncer"
      fi
      if [[ "$PREVIOUS_PSN_CLEARED" == "true" ]]; then
        dokku postgres:set "$PREVIOUS_SERVICE" post-start-network "$PREVIOUS_NETWORK" || dokku_log_warn "Failed to restore post-start-network of $PREVIOUS_SERVICE during rollback; re-run: dokku pgbouncer:connect $MAIN_APP $PREVIOUS_SERVICE"
      fi
      if [[ "$PREVIOUS_CONTAINER_DETACHED" == "true" ]] && ! container_on_network "dokku.postgres.${PREVIOUS_SERVICE}" "$PREVIOUS_NETWORK"; then
        docker network connect "$PREVIOUS_NETWORK" "dokku.postgres.${PREVIOUS_SERVICE}" || dokku_log_warn "Failed to reattach $PREVIOUS_SERVICE to network $PREVIOUS_NETWORK during rollback; re-run: dokku pgbouncer:connect $MAIN_APP $PREVIOUS_SERVICE"
      fi
    }

    # Every failure from here on leaves the main app as it was found, on direct
    # postgres, and the postgres services as they were found. On a re-run over a
    # working setup that means the app drops back to DATABASE_URL rather than
    # keeping PGBOUNCER_URL pointed at a pgbouncer this run may have already
    # half-reconfigured. Services are restored first so the app is restarted
    # against a postgres that is reachable again.
    fail_and_rollback() {
      rollback_services
      rollback_main_app
      dokku_log_fail "$1"
    }

    # Repointing this app at a different postgres service leaves the old
    # service attached to our network and its post-start-network still pointing
    # at us, which both widens the network's trust boundary and permanently
    # blocks that service from backing another pgbouncer.
    if [[ -n "$PREVIOUS_SERVICE" && "$PREVIOUS_SERVICE" != "$DB_SERVICE" ]]; then
      dokku_log_info1 "$BOUNCER_APP was connected to postgres service $PREVIOUS_SERVICE, detaching that first"
      PREVIOUS_PSN=$(dokku postgres:info "$PREVIOUS_SERVICE" --post-start-network 2>/dev/null) || {
        PREVIOUS_PSN=""
        dokku_log_warn "Could not read post-start-network of $PREVIOUS_SERVICE, leaving it alone"
      }
      if [[ "$PREVIOUS_PSN" == "$PREVIOUS_NETWORK" ]]; then
        # Flag only on success, so a rollback restores what was really changed.
        if dokku postgres:set "$PREVIOUS_SERVICE" post-start-network ""; then
          PREVIOUS_PSN_CLEARED=true
        else
          dokku_log_warn "Failed to clear post-start-network on $PREVIOUS_SERVICE, continuing"
        fi
      fi
      if container_on_network "dokku.postgres.${PREVIOUS_SERVICE}" "$PREVIOUS_NETWORK"; then
        if docker network disconnect "$PREVIOUS_NETWORK" "dokku.postgres.${PREVIOUS_SERVICE}"; then
          PREVIOUS_CONTAINER_DETACHED=true
        else
          dokku_log_warn "Failed to disconnect $PREVIOUS_SERVICE from network $PREVIOUS_NETWORK, continuing"
        fi
      fi
    fi

    # Attach the network to all three: main app, pgbouncer, and postgres.
    if [[ " $ORIGINAL_MAIN_APP_NETWORKS " == *" $NETWORK_NAME "* ]]; then
      dokku_log_info1 "$MAIN_APP already set to attach to $NETWORK_NAME"
    else
      dokku_log_info1 "Attaching network to $MAIN_APP"
      # shellcheck disable=SC2086
      dokku network:set "$MAIN_APP" attach-post-create $ORIGINAL_MAIN_APP_NETWORKS "$NETWORK_NAME" || fail_and_rollback "Failed to attach network to $MAIN_APP"
      MAIN_APP_NETWORK_ADDED=true
    fi

    dokku_log_info1 "Attaching network to $BOUNCER_APP"
    dokku network:set "$BOUNCER_APP" attach-post-create "$NETWORK_NAME" || fail_and_rollback "Failed to attach network to $BOUNCER_APP"

    dokku_log_info1 "Attaching postgres service $DB_SERVICE to network"
    # Set post-start-network so postgres rejoins the network on restart. Already
    # known to be either unset or ours, checked above before anything changed.
    if [[ "$CURRENT_PSN" != "$NETWORK_NAME" ]]; then
      dokku postgres:set "$DB_SERVICE" post-start-network "$NETWORK_NAME" || fail_and_rollback "Failed to set post-start-network on postgres service $DB_SERVICE"
      NEW_PSN_SET=true
    fi
    # Also connect the running container immediately.
    if container_on_network "dokku.postgres.${DB_SERVICE}" "$NETWORK_NAME"; then
      dokku_log_info1 "Postgres container already on network $NETWORK_NAME"
    else
      docker network connect "$NETWORK_NAME" "dokku.postgres.${DB_SERVICE}" || fail_and_rollback "Failed to connect postgres container dokku.postgres.${DB_SERVICE} to network $NETWORK_NAME"
      NEW_CONTAINER_CONNECTED=true
    fi

    # Config plus the metadata pgbouncer:disconnect needs to undo everything.
    # DATABASES_DBNAME is the name the image's entrypoint reads (not DATABASES_DB).
    # Deliberately NOT --no-restart: git:from-image below skips the deploy when
    # the image is unchanged, so on a re-run (e.g. rotated credentials) this
    # restart is the only thing that applies the new values. On the first run
    # the app is not deployed yet, so nothing restarts.
    dokku_log_info1 "Setting pgbouncer config"
    dokku config:set "$BOUNCER_APP" \
      DATABASES_HOST="dokku.postgres.${DB_SERVICE}" \
      DATABASES_USER="$DB_USER" \
      DATABASES_PASSWORD="$DB_PASSWORD" \
      DATABASES_PORT="$DB_PORT" \
      DATABASES_DBNAME="$DB_NAME" \
      DOKKU_PGBOUNCER_DB_SERVICE="$DB_SERVICE" \
      DOKKU_PGBOUNCER_NETWORK="$NETWORK_NAME" \
      || fail_and_rollback "Failed to set pgbouncer config on $BOUNCER_APP"

    dokku_log_info1 "Deploying pgbouncer image"
    dokku git:from-image "$BOUNCER_APP" "$PGBOUNCER_IMAGE" || fail_and_rollback "Failed to deploy pgbouncer image"

    # Verify the database is actually usable THROUGH pgbouncer before pointing
    # the main app at it. A TCP connect is not enough: pgbouncer accepts
    # clients as soon as it listens and only dials postgres on first query, so
    # wrong credentials or an unreachable postgres would pass unnoticed and
    # break the app at query time instead. Runs in a throwaway container so we
    # don't depend on a postgres client existing inside the main app's image.
    #
    # Reuse the postgres service's own image: it is guaranteed to be on this
    # host already and its psql matches the server version.
    PROBE_IMAGE=$(docker inspect --format '{{.Config.Image}}' "dokku.postgres.${DB_SERVICE}" 2>/dev/null || true)
    if [[ -z "$PROBE_IMAGE" ]] || ! docker image inspect "$PROBE_IMAGE" >/dev/null 2>&1; then
      PROBE_IMAGE="$PROBE_FALLBACK_IMAGE"
      # Pull up front so a registry problem fails with its own message instead
      # of masquerading as a pgbouncer connectivity failure.
      docker image inspect "$PROBE_IMAGE" >/dev/null 2>&1 ||
        docker pull "$PROBE_IMAGE" >/dev/null ||
        fail_and_rollback "Failed to pull $PROBE_IMAGE, which is needed to verify the pgbouncer connection"
    fi

    # USERINFO keeps the original percent-encoding, so the URL stays valid.
    PGBOUNCER_URL="postgres://${USERINFO}@${BOUNCER_HOST}:${BOUNCER_PORT}/${DB_NAME_ENCODED}"
    # The probe URL carries no password: 'docker run' arguments are visible to
    # every user on the host through ps, so it goes via the environment ('-e
    # PGPASSWORD' with no value forwards ours) instead.
    PROBE_URL="postgres://${USERINFO%%:*}@${BOUNCER_HOST}:${BOUNCER_PORT}/${DB_NAME_ENCODED}"
    # PGCONNECT_TIMEOUT only bounds the handshake with pgbouncer, which accepts
    # clients immediately. If postgres is unreachable behind it, the query then
    # blocks for pgbouncer's query_wait_timeout — 120s by default — so without
    # an outer bound five attempts can hang for ten minutes before reporting
    # failure. 'timeout' is coreutils, i.e. always present on a dokku host.
    PROBE_TIMEOUT=(timeout 20)
    if ! command -v timeout >/dev/null 2>&1; then
      PROBE_TIMEOUT=()
      dokku_log_warn "'timeout' not found; the pgbouncer probe will not be time-bounded"
    fi

    dokku_log_info1 "Verifying the database is reachable through pgbouncer"
    VERIFY_OK=false
    for _ in 1 2 3 4 5; do
      if VERIFY_OUTPUT=$(PGPASSWORD="$DB_PASSWORD" "${PROBE_TIMEOUT[@]}" docker run --rm --network "$NETWORK_NAME" \
        -e PGPASSWORD -e PGCONNECT_TIMEOUT=5 "$PROBE_IMAGE" \
        psql "$PROBE_URL" -w -v ON_ERROR_STOP=1 -tAqc 'SELECT 1' 2>&1); then
        VERIFY_OK=true
        break
      fi
      sleep 2
    done
    if [[ "$VERIFY_OK" != "true" ]]; then
      dokku_log_warn "Cannot query the database through pgbouncer at ${BOUNCER_HOST}:${BOUNCER_PORT} on network ${NETWORK_NAME}."
      dokku_log_warn "Output: $VERIFY_OUTPUT"
      dokku_log_warn "$MAIN_APP is being left on DATABASE_URL (direct postgres)."
      dokku_log_warn "Check: dokku logs $BOUNCER_APP, docker network inspect ${NETWORK_NAME}"
      rollback_services
      rollback_main_app
      dokku_log_fail "Pgbouncer verification failed"
    fi

    # Publish pgbouncer connection info on the main app and restart it.
    # DATABASE_URL (direct postgres) is left untouched — the app decides
    # which connection to use based on PGBOUNCER_URL being set.
    dokku_log_info1 "Setting pgbouncer env vars on $MAIN_APP"
    dokku config:set --no-restart "$MAIN_APP" \
      PGBOUNCER_URL="$PGBOUNCER_URL" \
      PGBOUNCER_HOST="$BOUNCER_HOST" \
      PGBOUNCER_PORT="$BOUNCER_PORT" \
      || fail_and_rollback "Failed to set pgbouncer env vars on $MAIN_APP"

    # ps:restart, not ps:rebuild: attach-post-create takes effect when the
    # containers are created, so recreating them from the existing image is
    # enough. A rebuild would additionally recompile from source, letting an
    # unrelated build regression turn "add connection pooling" into a failed
    # deploy on an otherwise healthy app.
    dokku_log_info1 "Restarting $MAIN_APP to join network"
    # Set before the attempt, not after: a restart that fails part way through
    # may already have recreated containers carrying PGBOUNCER_URL, so the
    # rollback has to restart the app in that case too.
    MAIN_APP_RESTARTED=true
    if ! dokku ps:restart "$MAIN_APP"; then
      dokku_log_warn "Restart of $MAIN_APP failed, rolling back pgbouncer setup on $MAIN_APP"
      fail_and_rollback "Failed to restart $MAIN_APP; the pgbouncer setup on $MAIN_APP was rolled back"
    fi

    # Confirm the recreated containers actually joined the network; if not, roll
    # back so the app is not left pointing at a pgbouncer it cannot reach.
    # MAIN_APP_RESTARTED makes the rollback restart the app again, so both
    # branches below leave its running containers matching its config.
    dokku_log_info1 "Verifying $MAIN_APP joined network $NETWORK_NAME"
    NETWORK_MEMBERS=$(docker network inspect "$NETWORK_NAME" --format '{{range .Containers}}{{.Name}}{{"\n"}}{{end}}') ||
      fail_and_rollback "Failed to inspect network $NETWORK_NAME"
    if [[ $'\n'"$NETWORK_MEMBERS" != *$'\n'"${MAIN_APP}."* ]]; then
      dokku_log_warn "$MAIN_APP containers are not attached to ${NETWORK_NAME}, rolling back to direct postgres"
      fail_and_rollback "$MAIN_APP did not join network $NETWORK_NAME; the pgbouncer setup on $MAIN_APP was rolled back. Check: docker network inspect ${NETWORK_NAME}"
    fi

    dokku_log_info1 "Done! PGBOUNCER_URL is now set on $MAIN_APP"
    dokku_log_info1 "The app should use PGBOUNCER_URL instead of DATABASE_URL for pooled connections"
    ;;

  pgbouncer:disconnect)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    MAIN_APP="$2"
    DB_SERVICE="${3:-}"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"
    NETWORK_NAME="pgbouncer-${MAIN_APP}"

    # The bouncer app name is derived from the app name, which may have changed
    # since connect (apps:rename). PGBOUNCER_HOST was recorded on the app
    # itself, so it survives the rename and still names the real bouncer app —
    # from which the network and service metadata below then follow.
    STORED_HOST=$(dokku config:get "$MAIN_APP" PGBOUNCER_HOST 2>/dev/null || true)
    if [[ -n "$STORED_HOST" && "${STORED_HOST%.web}" != "$BOUNCER_APP" ]] &&
      dokku apps:exists "${STORED_HOST%.web}" >/dev/null 2>&1; then
      dokku_log_info1 "$MAIN_APP records its pgbouncer as '${STORED_HOST%.web}' rather than $BOUNCER_APP (renamed app?), using that"
      BOUNCER_APP="${STORED_HOST%.web}"
    fi

    if dokku apps:exists "$BOUNCER_APP" >/dev/null 2>&1; then
      BOUNCER_EXISTS=true
    else
      BOUNCER_EXISTS=false
    fi

    # Prefer the metadata recorded at connect time over defaults and arguments
    STORED_NETWORK=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_NETWORK 2>/dev/null || true)
    [[ -n "$STORED_NETWORK" ]] && NETWORK_NAME="$STORED_NETWORK"
    STORED_SERVICE=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_DB_SERVICE 2>/dev/null || true)
    if [[ -n "$STORED_SERVICE" ]]; then
      if [[ -n "$DB_SERVICE" && "$DB_SERVICE" != "$STORED_SERVICE" ]]; then
        dokku_log_warn "Ignoring given service '$DB_SERVICE'; connect was run against '$STORED_SERVICE'"
      fi
      DB_SERVICE="$STORED_SERVICE"
    fi
    [[ -z "$DB_SERVICE" ]] && dokku_log_fail "Could not determine the postgres service ($BOUNCER_APP has no metadata). Pass it explicitly: dokku pgbouncer:disconnect $MAIN_APP <service>"

    # The bouncer app name is derived by convention, so refuse to destroy an
    # app of that name that this plugin did not create. Checked before anything
    # is changed, so a name collision cannot leave a half-done disconnect.
    if [[ "$BOUNCER_EXISTS" == "true" && -z "$STORED_SERVICE" ]]; then
      dokku_log_fail "App $BOUNCER_APP exists but was not created by this plugin (no DOKKU_PGBOUNCER_DB_SERVICE set). Refusing to destroy it. Remove it by hand if it really is the pgbouncer app: dokku apps:destroy $BOUNCER_APP"
    fi

    # The main app may already be gone (destroyed by hand), in which case there
    # is nothing to move back onto direct postgres — but the pgbouncer app,
    # network and post-start-network still need releasing.
    if dokku apps:exists "$MAIN_APP" >/dev/null 2>&1; then
      # Remove PGBOUNCER_URL from the app — the app falls back to DATABASE_URL
      dokku_log_info1 "Removing PGBOUNCER_URL from $MAIN_APP"
      dokku config:unset --no-restart "$MAIN_APP" PGBOUNCER_URL PGBOUNCER_HOST PGBOUNCER_PORT || dokku_log_fail "Failed to unset pgbouncer env vars on $MAIN_APP"

      # Detach our network from the main app, keeping any other networks it has
      MAIN_APP_NETWORKS=$(dokku network:report "$MAIN_APP" --network-attach-post-create) || dokku_log_fail "Failed to read attach-post-create networks of $MAIN_APP"
      REMAINING_NETWORKS=""
      for net in $MAIN_APP_NETWORKS; do
        [[ "$net" == "$NETWORK_NAME" ]] && continue
        REMAINING_NETWORKS="$REMAINING_NETWORKS $net"
      done
      dokku_log_info1 "Detaching network $NETWORK_NAME from $MAIN_APP"
      # shellcheck disable=SC2086
      dokku network:set "$MAIN_APP" attach-post-create $REMAINING_NETWORKS || dokku_log_fail "Failed to detach network from $MAIN_APP"

      # Not fatal: the remaining steps are exactly what was asked for, and they
      # are the only way to release the postgres service's single-valued
      # post-start-network. Aborting here used to strand the bouncer app, the
      # network and that property with no command left that would clean them up —
      # every retry died on this same line. Common causes are an app that is
      # scaled to zero, was never deployed, or no longer builds.
      dokku_log_info1 "Restarting $MAIN_APP"
      if ! dokku ps:restart "$MAIN_APP"; then
        dokku_log_warn "Failed to restart $MAIN_APP; its running containers may still have PGBOUNCER_URL set until the next deploy. Continuing with the teardown."
      fi
    else
      dokku_log_info1 "App $MAIN_APP does not exist, only tearing down the pgbouncer side"
    fi

    # App is now running on direct postgres. Safe to tear down pgbouncer.
    if [[ "$BOUNCER_EXISTS" == "true" ]]; then
      dokku_log_info1 "Destroying pgbouncer app: $BOUNCER_APP"
      # Also not fatal, for the same reason: the postgres service still has to
      # be released, and a retry can pick the destroy up again.
      dokku apps:destroy "$BOUNCER_APP" --force || dokku_log_warn "Failed to destroy $BOUNCER_APP, continuing with the teardown"
    else
      dokku_log_info1 "Pgbouncer app $BOUNCER_APP does not exist, skipping destroy"
    fi

    dokku_log_info1 "Detaching postgres service $DB_SERVICE from network"
    # post-start-network is single-valued and may have been repointed at
    # something else since connect; only clear it if it is still ours.
    CURRENT_PSN=$(dokku postgres:info "$DB_SERVICE" --post-start-network 2>/dev/null) || {
      CURRENT_PSN=""
      dokku_log_warn "Could not read post-start-network of $DB_SERVICE, leaving it alone"
    }
    if [[ "$CURRENT_PSN" == "$NETWORK_NAME" ]]; then
      dokku postgres:set "$DB_SERVICE" post-start-network "" || dokku_log_warn "Failed to clear post-start-network on postgres service $DB_SERVICE, continuing"
    elif [[ -n "$CURRENT_PSN" ]]; then
      dokku_log_info1 "post-start-network of $DB_SERVICE is '$CURRENT_PSN', not $NETWORK_NAME; leaving it alone"
    fi

    if dokku network:exists "$NETWORK_NAME" >/dev/null 2>&1; then
      # The running container was attached with 'docker network connect'; the
      # network cannot be destroyed while it is still an endpoint.
      if container_on_network "dokku.postgres.${DB_SERVICE}" "$NETWORK_NAME"; then
        docker network disconnect "$NETWORK_NAME" "dokku.postgres.${DB_SERVICE}" || dokku_log_warn "Failed to disconnect postgres container from $NETWORK_NAME"
      else
        dokku_log_info1 "Postgres container already off network $NETWORK_NAME"
      fi
      dokku_log_info1 "Removing network: $NETWORK_NAME"
      dokku network:destroy "$NETWORK_NAME" --force || dokku_log_fail "Failed to destroy network $NETWORK_NAME. Check: docker network inspect $NETWORK_NAME"
    else
      dokku_log_info1 "Network $NETWORK_NAME does not exist, skipping"
    fi

    dokku_log_info1 "Done! $MAIN_APP is back on direct postgres"
    ;;

  pgbouncer:info)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    MAIN_APP="$2"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"

    dokku config:show "$BOUNCER_APP" | sed -E 's/^(DATABASES_PASSWORD:[[:space:]]*).*/\1[redacted]/' || dokku_log_fail "Failed to show config for $BOUNCER_APP. Is pgbouncer set up for this app?"
    ;;

  help | pgbouncer | pgbouncer:help)
    help_content_func() {
      # shellcheck disable=SC2034 # dokku's plugin help machinery reads $desc
      declare desc="return pgbouncer plugin help content"
      cat <<EOF
    pgbouncer:connect <app> <service>, Set up pgbouncer for a postgres service and publish PGBOUNCER_URL on the app
    pgbouncer:disconnect <app> [<service>], Remove pgbouncer and PGBOUNCER_URL from the app
    pgbouncer:info <app>, Show pgbouncer config for an app
EOF
    }
    # Bare 'dokku pgbouncer' gets the human-readable form; plain 'help' is
    # dokku's own help machinery asking for the machine-readable listing.
    if [[ $1 == "pgbouncer:help" || $1 == "pgbouncer" ]]; then
      echo -e "Usage: dokku pgbouncer[:COMMAND]"
      echo ""
      echo -e "Manage pgbouncer connection pooling"
      echo ""
      echo -e "Additional commands:"
      help_content_func | sort | column -c2 -t -s,
    else
      help_content_func
    fi
    ;;

  *)
    exit "$DOKKU_NOT_IMPLEMENTED_EXIT"
    ;;
esac
