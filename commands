#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"

PLUGIN_BASE_PATH="${PLUGIN_BASE_PATH:-/var/lib/dokku/plugins}"

# Pinned: the pgbouncer/pgbouncer image reads DATABASES_* env vars whose names
# are an implementation detail of its entrypoint, so "latest" could break us.
PGBOUNCER_IMAGE="pgbouncer/pgbouncer:1.15.0"

urldecode() {
  # Decode %XX escapes (DATABASE_URL userinfo may be percent-encoded)
  printf '%b' "${1//%/\\x}"
}

case "$1" in
  pgbouncer:connect)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    [[ -z "$3" ]] && dokku_log_fail "Please specify a postgres service name"
    MAIN_APP="$2"
    DB_SERVICE="$3"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"

    # Get DATABASE_URL from the main app (set by postgres:link)
    DATABASE_URL=$(dokku config:get "$MAIN_APP" DATABASE_URL) || dokku_log_fail "Failed to read DATABASE_URL from $MAIN_APP"
    [[ -z "$DATABASE_URL" ]] && dokku_log_fail "No DATABASE_URL found on $MAIN_APP. Link a postgres service first."

    # Parse DATABASE_URL: postgres://USER:PASSWORD@HOST:PORT/DB
    URL_BODY="${DATABASE_URL#postgres://}"
    URL_BODY="${URL_BODY#postgresql://}"
    [[ "$URL_BODY" == "$DATABASE_URL" ]] && dokku_log_fail "DATABASE_URL on $MAIN_APP is not a postgres:// URL"
    [[ "$URL_BODY" != *@* ]] && dokku_log_fail "DATABASE_URL on $MAIN_APP has no credentials part"

    # Split on the LAST @ so a password containing @ still parses
    USERINFO="${URL_BODY%@*}"
    HOSTINFO="${URL_BODY##*@}"

    if [[ "$USERINFO" == *:* ]]; then
      DB_USER=$(urldecode "${USERINFO%%:*}")
      DB_PASSWORD=$(urldecode "${USERINFO#*:}")
    else
      DB_USER=$(urldecode "$USERINFO")
      DB_PASSWORD=""
    fi

    HOSTPORT="${HOSTINFO%%/*}"
    DB_NAME="${HOSTINFO#*/}"
    DB_NAME="${DB_NAME%%\?*}"

    DB_HOST="${HOSTPORT%%:*}"
    DB_PORT="${HOSTPORT#*:}"
    [[ "$DB_PORT" == "$DB_HOST" ]] && DB_PORT="5432"

    [[ -z "$DB_USER" ]] && dokku_log_fail "Failed to parse user from DATABASE_URL"
    [[ -z "$DB_PASSWORD" ]] && dokku_log_fail "Failed to parse password from DATABASE_URL"
    [[ -z "$DB_HOST" ]] && dokku_log_fail "Failed to parse host from DATABASE_URL"
    [[ -z "$DB_NAME" ]] && dokku_log_fail "Failed to parse database name from DATABASE_URL"

    BOUNCER_PORT="6432"
    BOUNCER_HOST="${BOUNCER_APP}.web"

    # Create a shared network for the app, pgbouncer, and postgres
    NETWORK_NAME="pgbouncer-${MAIN_APP}"
    if dokku network:exists "$NETWORK_NAME" >/dev/null 2>&1; then
      dokku_log_info1 "Network $NETWORK_NAME already exists"
    else
      dokku_log_info1 "Creating network: $NETWORK_NAME"
      dokku network:create "$NETWORK_NAME" || dokku_log_fail "Failed to create network $NETWORK_NAME"
    fi

    if dokku apps:exists "$BOUNCER_APP" >/dev/null 2>&1; then
      dokku_log_info1 "App $BOUNCER_APP already exists, reusing it"
    else
      dokku_log_info1 "Creating pgbouncer app: $BOUNCER_APP"
      dokku apps:create "$BOUNCER_APP" || dokku_log_fail "Failed to create app $BOUNCER_APP"
    fi

    # Pgbouncer speaks the postgres protocol; it must not be reachable through nginx
    dokku_log_info1 "Disabling the http proxy for $BOUNCER_APP"
    dokku proxy:disable "$BOUNCER_APP" || dokku_log_warn "Failed to disable proxy for $BOUNCER_APP, continuing"

    # Attach the network to all three: main app, pgbouncer, and postgres.
    # Merge with any attach-post-create networks the app already has instead of clobbering them.
    MAIN_APP_NETWORKS=$(dokku network:report "$MAIN_APP" --network-attach-post-create) || dokku_log_fail "Failed to read attach-post-create networks of $MAIN_APP"
    if [[ " $MAIN_APP_NETWORKS " == *" $NETWORK_NAME "* ]]; then
      dokku_log_info1 "$MAIN_APP already set to attach to $NETWORK_NAME"
    else
      dokku_log_info1 "Attaching network to $MAIN_APP"
      # shellcheck disable=SC2086
      dokku network:set "$MAIN_APP" attach-post-create $MAIN_APP_NETWORKS "$NETWORK_NAME" || dokku_log_fail "Failed to attach network to $MAIN_APP"
    fi

    dokku_log_info1 "Attaching network to $BOUNCER_APP"
    dokku network:set "$BOUNCER_APP" attach-post-create "$NETWORK_NAME" || dokku_log_fail "Failed to attach network to $BOUNCER_APP"

    dokku_log_info1 "Attaching postgres service $DB_SERVICE to network"
    # Set post-start-network so postgres rejoins the network on restart
    dokku postgres:set "$DB_SERVICE" post-start-network "$NETWORK_NAME" || dokku_log_fail "Failed to set post-start-network on postgres service $DB_SERVICE"
    # Also connect the running container immediately
    CONNECT_OUTPUT=$(docker network connect "$NETWORK_NAME" "dokku.postgres.${DB_SERVICE}" 2>&1) || {
      if echo "$CONNECT_OUTPUT" | grep -q "already exists"; then
        dokku_log_info1 "Postgres container already on network $NETWORK_NAME"
      else
        dokku_log_fail "Failed to connect postgres container dokku.postgres.${DB_SERVICE} to network $NETWORK_NAME: $CONNECT_OUTPUT"
      fi
    }

    # Config plus the metadata pgbouncer:disconnect needs to undo everything.
    # DATABASES_DBNAME is the name the image's entrypoint reads (not DATABASES_DB).
    dokku_log_info1 "Setting pgbouncer config"
    dokku config:set --no-restart "$BOUNCER_APP" \
      DATABASES_HOST="dokku.postgres.${DB_SERVICE}" \
      DATABASES_USER="$DB_USER" \
      DATABASES_PASSWORD="$DB_PASSWORD" \
      DATABASES_PORT="$DB_PORT" \
      DATABASES_DBNAME="$DB_NAME" \
      DOKKU_PGBOUNCER_DB_SERVICE="$DB_SERVICE" \
      DOKKU_PGBOUNCER_NETWORK="$NETWORK_NAME" \
      || dokku_log_fail "Failed to set pgbouncer config on $BOUNCER_APP"

    dokku_log_info1 "Deploying pgbouncer image"
    dokku git:from-image "$BOUNCER_APP" "$PGBOUNCER_IMAGE" || dokku_log_fail "Failed to deploy pgbouncer image"

    # Verify pgbouncer is reachable on the shared network BEFORE pointing the
    # main app at it. Uses a throwaway container so we don't depend on bash or
    # nc existing inside the main app's image.
    dokku_log_info1 "Verifying pgbouncer is reachable on $NETWORK_NAME"
    VERIFY_OK=false
    for _ in 1 2 3 4 5; do
      if VERIFY_OUTPUT=$(docker run --rm --network "$NETWORK_NAME" busybox:stable sh -c "nc -w 3 ${BOUNCER_HOST} ${BOUNCER_PORT} </dev/null" 2>&1); then
        VERIFY_OK=true
        break
      fi
      sleep 2
    done
    if [[ "$VERIFY_OK" != "true" ]]; then
      dokku_log_warn "Cannot reach pgbouncer at ${BOUNCER_HOST}:${BOUNCER_PORT} on network ${NETWORK_NAME}."
      dokku_log_warn "Output: $VERIFY_OUTPUT"
      dokku_log_warn "$MAIN_APP has not been touched and is still using DATABASE_URL directly."
      dokku_log_warn "Check: docker network inspect ${NETWORK_NAME}"
      dokku_log_fail "Pgbouncer connectivity verification failed"
    fi

    # Publish pgbouncer connection info on the main app and rebuild.
    # DATABASE_URL (direct postgres) is left untouched — the app decides
    # which connection to use based on PGBOUNCER_URL being set.
    # USERINFO keeps the original percent-encoding, so the URL stays valid
    # and carries the password in case pgbouncer auth is tightened later.
    PGBOUNCER_URL="postgres://${USERINFO}@${BOUNCER_HOST}:${BOUNCER_PORT}/${DB_NAME}"
    dokku_log_info1 "Setting pgbouncer env vars on $MAIN_APP"
    dokku config:set --no-restart "$MAIN_APP" \
      PGBOUNCER_URL="$PGBOUNCER_URL" \
      PGBOUNCER_HOST="$BOUNCER_HOST" \
      PGBOUNCER_PORT="$BOUNCER_PORT" \
      || dokku_log_fail "Failed to set pgbouncer env vars on $MAIN_APP"

    dokku_log_info1 "Rebuilding $MAIN_APP to join network"
    dokku ps:rebuild "$MAIN_APP" || dokku_log_fail "Failed to rebuild $MAIN_APP"

    # Confirm the rebuilt containers actually joined the network; if not, roll
    # back so the app is not left pointing at a pgbouncer it cannot reach.
    dokku_log_info1 "Verifying $MAIN_APP joined network $NETWORK_NAME"
    if ! docker network inspect "$NETWORK_NAME" --format '{{range .Containers}}{{.Name}}{{"\n"}}{{end}}' | grep -q "^${MAIN_APP}\."; then
      dokku_log_warn "$MAIN_APP containers are not attached to ${NETWORK_NAME}, rolling back to direct postgres"
      dokku config:unset --no-restart "$MAIN_APP" PGBOUNCER_URL PGBOUNCER_HOST PGBOUNCER_PORT || dokku_log_warn "Failed to unset pgbouncer env vars on $MAIN_APP"
      dokku ps:rebuild "$MAIN_APP" || dokku_log_warn "Failed to rebuild $MAIN_APP during rollback"
      dokku_log_fail "$MAIN_APP did not join network $NETWORK_NAME; pgbouncer env vars were rolled back. Check: docker network inspect ${NETWORK_NAME}"
    fi

    dokku_log_info1 "Done! PGBOUNCER_URL is now set on $MAIN_APP"
    dokku_log_info1 "The app should use PGBOUNCER_URL instead of DATABASE_URL for pooled connections"
    ;;

  pgbouncer:disconnect)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    MAIN_APP="$2"
    DB_SERVICE="${3:-}"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"
    NETWORK_NAME="pgbouncer-${MAIN_APP}"

    # Prefer the metadata recorded at connect time over defaults and arguments
    STORED_NETWORK=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_NETWORK 2>/dev/null || true)
    [[ -n "$STORED_NETWORK" ]] && NETWORK_NAME="$STORED_NETWORK"
    STORED_SERVICE=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_DB_SERVICE 2>/dev/null || true)
    if [[ -n "$STORED_SERVICE" ]]; then
      if [[ -n "$DB_SERVICE" && "$DB_SERVICE" != "$STORED_SERVICE" ]]; then
        dokku_log_warn "Ignoring given service '$DB_SERVICE'; connect was run against '$STORED_SERVICE'"
      fi
      DB_SERVICE="$STORED_SERVICE"
    fi
    [[ -z "$DB_SERVICE" ]] && dokku_log_fail "Could not determine the postgres service ($BOUNCER_APP has no metadata). Pass it explicitly: dokku pgbouncer:disconnect $MAIN_APP <service>"

    # Remove PGBOUNCER_URL from the app — the app falls back to DATABASE_URL
    dokku_log_info1 "Removing PGBOUNCER_URL from $MAIN_APP"
    dokku config:unset --no-restart "$MAIN_APP" PGBOUNCER_URL PGBOUNCER_HOST PGBOUNCER_PORT || dokku_log_fail "Failed to unset pgbouncer env vars on $MAIN_APP"

    # Detach our network from the main app, keeping any other networks it has
    MAIN_APP_NETWORKS=$(dokku network:report "$MAIN_APP" --network-attach-post-create) || dokku_log_fail "Failed to read attach-post-create networks of $MAIN_APP"
    REMAINING_NETWORKS=""
    for net in $MAIN_APP_NETWORKS; do
      [[ "$net" == "$NETWORK_NAME" ]] && continue
      REMAINING_NETWORKS="$REMAINING_NETWORKS $net"
    done
    dokku_log_info1 "Detaching network $NETWORK_NAME from $MAIN_APP"
    # shellcheck disable=SC2086
    dokku network:set "$MAIN_APP" attach-post-create $REMAINING_NETWORKS || dokku_log_fail "Failed to detach network from $MAIN_APP"

    dokku_log_info1 "Rebuilding $MAIN_APP"
    dokku ps:rebuild "$MAIN_APP" || dokku_log_fail "Failed to rebuild $MAIN_APP"

    # App is now running on direct postgres. Safe to tear down pgbouncer.
    if dokku apps:exists "$BOUNCER_APP" >/dev/null 2>&1; then
      dokku_log_info1 "Destroying pgbouncer app: $BOUNCER_APP"
      dokku apps:destroy "$BOUNCER_APP" --force || dokku_log_fail "Failed to destroy $BOUNCER_APP"
    else
      dokku_log_info1 "Pgbouncer app $BOUNCER_APP does not exist, skipping destroy"
    fi

    dokku_log_info1 "Detaching postgres service $DB_SERVICE from network"
    dokku postgres:set "$DB_SERVICE" post-start-network "" || dokku_log_warn "Failed to clear post-start-network on postgres service $DB_SERVICE, continuing"
    # The running container was attached with 'docker network connect'; the
    # network cannot be destroyed while it is still an endpoint.
    DISCONNECT_OUTPUT=$(docker network disconnect "$NETWORK_NAME" "dokku.postgres.${DB_SERVICE}" 2>&1) || {
      if echo "$DISCONNECT_OUTPUT" | grep -qiE "is not connected|not found|no such"; then
        dokku_log_info1 "Postgres container already off network $NETWORK_NAME"
      else
        dokku_log_warn "Failed to disconnect postgres container from $NETWORK_NAME: $DISCONNECT_OUTPUT"
      fi
    }

    if dokku network:exists "$NETWORK_NAME" >/dev/null 2>&1; then
      dokku_log_info1 "Removing network: $NETWORK_NAME"
      dokku network:destroy "$NETWORK_NAME" --force || dokku_log_fail "Failed to destroy network $NETWORK_NAME. Check: docker network inspect $NETWORK_NAME"
    else
      dokku_log_info1 "Network $NETWORK_NAME does not exist, skipping"
    fi

    dokku_log_info1 "Done! $MAIN_APP is back on direct postgres"
    ;;

  pgbouncer:info)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    MAIN_APP="$2"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"

    dokku config:show "$BOUNCER_APP" || dokku_log_fail "Failed to show config for $BOUNCER_APP. Is pgbouncer set up for this app?"
    ;;

  help | pgbouncer:help)
    help_content_func() {
      declare desc="return pgbouncer plugin help content"
      cat <<EOF
    pgbouncer:connect <app> <service>, Set up pgbouncer for a postgres service and publish PGBOUNCER_URL on the app
    pgbouncer:disconnect <app> [<service>], Remove pgbouncer and PGBOUNCER_URL from the app
    pgbouncer:info <app>, Show pgbouncer config for an app
EOF
    }
    if [[ $1 == "pgbouncer:help" ]]; then
      echo -e "Usage: dokku pgbouncer[:COMMAND]"
      echo ""
      echo -e "Manage pgbouncer connection pooling"
      echo ""
      echo -e "Additional commands:"
      help_content_func | sort | column -c2 -t -s,
    else
      help_content_func
    fi
    ;;

  *)
    exit "$DOKKU_NOT_IMPLEMENTED_EXIT"
    ;;
esac
