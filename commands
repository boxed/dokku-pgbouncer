#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"

PLUGIN_BASE_PATH="${PLUGIN_BASE_PATH:-/var/lib/dokku/plugins}"

case "$1" in
  pgbouncer:intercept-db)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    [[ -z "$3" ]] && dokku_log_fail "Please specify a postgres service name"
    MAIN_APP="$2"
    DB_SERVICE="$3"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"

    # Get DATABASE_URL from the main app (set by postgres:link)
    DATABASE_URL=$(dokku config:get "$MAIN_APP" DATABASE_URL) || dokku_log_fail "Failed to read DATABASE_URL from $MAIN_APP"
    [[ -z "$DATABASE_URL" ]] && dokku_log_fail "No DATABASE_URL found on $MAIN_APP. Link a postgres service first."

    # Parse DATABASE_URL: postgres://USER:PASSWORD@HOST:PORT/DB
    URL_BODY="${DATABASE_URL#postgres://}"
    URL_BODY="${URL_BODY#postgresql://}"

    USERINFO="${URL_BODY%%@*}"
    HOSTINFO="${URL_BODY#*@}"

    DB_USER="${USERINFO%%:*}"
    DB_PASSWORD="${USERINFO#*:}"

    HOSTPORT="${HOSTINFO%%/*}"
    DB_NAME="${HOSTINFO#*/}"
    DB_NAME="${DB_NAME%%\?*}"

    DB_HOST="${HOSTPORT%%:*}"
    DB_PORT="${HOSTPORT#*:}"
    [[ "$DB_PORT" == "$DB_HOST" ]] && DB_PORT="5432"

    [[ -z "$DB_USER" ]] && dokku_log_fail "Failed to parse user from DATABASE_URL"
    [[ -z "$DB_HOST" ]] && dokku_log_fail "Failed to parse host from DATABASE_URL"
    [[ -z "$DB_NAME" ]] && dokku_log_fail "Failed to parse database name from DATABASE_URL"

    # Create a shared network for the app, pgbouncer, and postgres
    NETWORK_NAME="pgbouncer-${MAIN_APP}"
    dokku_log_info1 "Creating network: $NETWORK_NAME"
    docker network create "$NETWORK_NAME" 2>/dev/null || dokku_log_info1 "Network $NETWORK_NAME already exists"

    dokku_log_info1 "Creating pgbouncer app: $BOUNCER_APP"
    dokku apps:create "$BOUNCER_APP" || dokku_log_fail "Failed to create app $BOUNCER_APP"

    # Attach the network to all three: main app, pgbouncer, and postgres
    dokku_log_info1 "Attaching network to $MAIN_APP"
    dokku network:set "$MAIN_APP" attach-post-create "$NETWORK_NAME" || dokku_log_fail "Failed to attach network to $MAIN_APP"

    dokku_log_info1 "Attaching network to $BOUNCER_APP"
    dokku network:set "$BOUNCER_APP" attach-post-create "$NETWORK_NAME" || dokku_log_fail "Failed to attach network to $BOUNCER_APP"

    dokku_log_info1 "Attaching postgres service $DB_SERVICE to network"
    CONNECT_OUTPUT=$(docker network connect "$NETWORK_NAME" "dokku.postgres.${DB_SERVICE}" 2>&1) || {
      if echo "$CONNECT_OUTPUT" | grep -q "already exists"; then
        dokku_log_info1 "Postgres container already on network $NETWORK_NAME"
      else
        dokku_log_fail "Failed to connect postgres container dokku.postgres.${DB_SERVICE} to network $NETWORK_NAME: $CONNECT_OUTPUT"
      fi
    }

    dokku_log_info1 "Setting pgbouncer config"
    dokku config:set --no-restart "$BOUNCER_APP" \
      DATABASES_HOST="$DB_HOST" \
      DATABASES_USER="$DB_USER" \
      DATABASES_PASSWORD="$DB_PASSWORD" \
      DATABASES_PORT="$DB_PORT" \
      DATABASES_DB="$DB_NAME" \
      || dokku_log_fail "Failed to set pgbouncer config on $BOUNCER_APP"

    dokku_log_info1 "Deploying pgbouncer image"
    dokku git:from-image "$BOUNCER_APP" pgbouncer/pgbouncer:latest || dokku_log_fail "Failed to deploy pgbouncer image"

    # Verify pgbouncer can connect to postgres before touching the main app
    dokku_log_info1 "Verifying pgbouncer can reach postgres"
    BOUNCER_HOST_IP=$(docker inspect --format "{{(index .NetworkSettings.Networks \"${NETWORK_NAME}\").IPAddress}}" "${BOUNCER_APP}.web.1") \
      || dokku_log_fail "Failed to get pgbouncer container IP on network $NETWORK_NAME"
    [[ -z "$BOUNCER_HOST_IP" ]] && dokku_log_fail "Pgbouncer container has no IP on network $NETWORK_NAME"
    VERIFY_OUTPUT=$(docker exec "dokku.postgres.${DB_SERVICE}" psql "postgres://${DB_USER}:${DB_PASSWORD}@${BOUNCER_HOST_IP}:6432/${DB_NAME}" -c "SELECT 1" 2>&1) || {
      dokku_log_fail "pgbouncer cannot connect to postgres. Aborting before modifying $MAIN_APP.
Output: $VERIFY_OUTPUT
Check pgbouncer logs: dokku logs $BOUNCER_APP"
    }
    dokku_log_info1 "pgbouncer connection verified"

    # Store metadata so remove-intercept-db can undo everything
    dokku_log_info1 "Storing metadata on $BOUNCER_APP"
    dokku config:set --no-restart "$BOUNCER_APP" \
      DOKKU_PGBOUNCER_DB_SERVICE="$DB_SERVICE" \
      DOKKU_PGBOUNCER_NETWORK="$NETWORK_NAME" \
      || dokku_log_fail "Failed to store metadata on $BOUNCER_APP"

    SERVICE_UPPER=$(echo "$DB_SERVICE" | tr '[:lower:]-' '[:upper:]_')
    PREFIX="DOKKU_POSTGRES_${SERVICE_UPPER}_"
    BOUNCER_HOST="${BOUNCER_APP}.web"
    BOUNCER_PORT="6432"

    # Read env vars from the postgres container
    dokku_log_info1 "Reading postgres container env vars"
    CONTAINER_ID=$(dokku postgres:info "$DB_SERVICE" --id) || dokku_log_fail "Failed to get postgres container ID for $DB_SERVICE"
    [[ -z "$CONTAINER_ID" ]] && dokku_log_fail "Got empty container ID for postgres service $DB_SERVICE"

    PG_ENV=$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$CONTAINER_ID") || dokku_log_fail "Failed to inspect postgres container $CONTAINER_ID"

    PG_VERSION=$(echo "$PG_ENV" | grep "^PG_VERSION=" | cut -d= -f2-)
    PG_MAJOR=$(echo "$PG_ENV" | grep "^PG_MAJOR=" | cut -d= -f2-)
    PG_LANG=$(echo "$PG_ENV" | grep "^LANG=" | cut -d= -f2-)
    PG_PGDATA=$(echo "$PG_ENV" | grep "^PGDATA=" | cut -d= -f2-)
    PG_GOSU=$(echo "$PG_ENV" | grep "^GOSU_VERSION=" | cut -d= -f2-)
    PG_PASSWORD=$(echo "$PG_ENV" | grep "^POSTGRES_PASSWORD=" | cut -d= -f2-)

    [[ -z "$PG_PASSWORD" ]] && dokku_log_fail "Failed to read POSTGRES_PASSWORD from postgres container"

    # Unlink postgres so it stops owning the runtime vars
    dokku_log_info1 "Unlinking postgres service $DB_SERVICE from $MAIN_APP"
    dokku postgres:unlink "$DB_SERVICE" "$MAIN_APP" --no-restart || dokku_log_fail "Failed to unlink postgres service $DB_SERVICE from $MAIN_APP"

    # Set all DOKKU_POSTGRES_* vars explicitly, with connectivity pointing to pgbouncer
    dokku_log_info1 "Updating $MAIN_APP to use pgbouncer"
    dokku config:set "$MAIN_APP" \
      DATABASE_URL="postgres://${DB_USER}@${BOUNCER_HOST}:${BOUNCER_PORT}/${DB_NAME}" \
      "${PREFIX}PORT_5432_TCP_ADDR=${BOUNCER_HOST}" \
      "${PREFIX}PORT_5432_TCP_PORT=${BOUNCER_PORT}" \
      "${PREFIX}PORT_5432_TCP_PROTO=tcp" \
      "${PREFIX}PORT_5432_TCP=tcp://${BOUNCER_HOST}:${BOUNCER_PORT}" \
      "${PREFIX}PORT=tcp://${BOUNCER_HOST}:${BOUNCER_PORT}" \
      "${PREFIX}NAME=/${MAIN_APP}.web.1/dokku-postgres-${DB_SERVICE}" \
      "${PREFIX}ENV_POSTGRES_PASSWORD=${PG_PASSWORD}" \
      "${PREFIX}ENV_PG_VERSION=${PG_VERSION}" \
      "${PREFIX}ENV_PG_MAJOR=${PG_MAJOR}" \
      "${PREFIX}ENV_LANG=${PG_LANG}" \
      "${PREFIX}ENV_PGDATA=${PG_PGDATA}" \
      "${PREFIX}ENV_GOSU_VERSION=${PG_GOSU}" \
      || dokku_log_fail "Failed to set env vars on $MAIN_APP"

    dokku_log_info1 "Done! $MAIN_APP is now using pgbouncer via $BOUNCER_APP"
    ;;

  pgbouncer:remove-intercept-db)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    [[ -z "$3" ]] && dokku_log_fail "Please specify a postgres service name"
    MAIN_APP="$2"
    DB_SERVICE="$3"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"
    NETWORK_NAME="pgbouncer-${MAIN_APP}"

    # Try to read metadata from pgbouncer app if it still exists
    STORED_SERVICE=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_DB_SERVICE 2>/dev/null || true)
    STORED_NETWORK=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_NETWORK 2>/dev/null || true)
    [[ -n "$STORED_NETWORK" ]] && NETWORK_NAME="$STORED_NETWORK"

    # Destroy pgbouncer app if it exists
    if dokku apps:exists "$BOUNCER_APP" 2>/dev/null; then
      dokku_log_info1 "Destroying pgbouncer app: $BOUNCER_APP"
      dokku apps:destroy "$BOUNCER_APP" --force || dokku_log_fail "Failed to destroy $BOUNCER_APP"
    else
      dokku_log_info1 "Pgbouncer app $BOUNCER_APP does not exist, skipping destroy"
    fi

    # Remove network if it exists
    if docker network inspect "$NETWORK_NAME" >/dev/null 2>&1; then
      dokku_log_info1 "Removing network: $NETWORK_NAME"
      dokku network:set "$MAIN_APP" attach-post-create "" || dokku_log_fail "Failed to detach network from $MAIN_APP"

      # Disconnect all containers from the network before removing it
      CONNECTED=$(docker network inspect "$NETWORK_NAME" --format '{{range .Containers}}{{.Name}} {{end}}' 2>/dev/null || true)
      for CONTAINER in $CONNECTED; do
        dokku_log_info1 "Disconnecting $CONTAINER from $NETWORK_NAME"
        docker network disconnect "$NETWORK_NAME" "$CONTAINER" || dokku_log_fail "Failed to disconnect $CONTAINER from $NETWORK_NAME"
      done

      docker network rm "$NETWORK_NAME" || dokku_log_fail "Failed to remove docker network $NETWORK_NAME"
    else
      dokku_log_info1 "Network $NETWORK_NAME does not exist, skipping removal"
    fi

    # Remove all DOKKU_POSTGRES_* vars and DATABASE_URL that we set
    dokku_log_info1 "Removing pgbouncer env vars from $MAIN_APP"
    VARS_TO_UNSET=$(dokku config:keys "$MAIN_APP" | grep "^DOKKU_POSTGRES_" || true)
    # shellcheck disable=SC2086
    dokku config:unset --no-restart "$MAIN_APP" DATABASE_URL $VARS_TO_UNSET || dokku_log_fail "Failed to unset env vars on $MAIN_APP"

    dokku_log_info1 "Restoring direct database connection for $MAIN_APP"
    dokku postgres:link "$DB_SERVICE" "$MAIN_APP" || dokku_log_fail "Failed to link postgres service $DB_SERVICE to $MAIN_APP"
    ;;

  pgbouncer:info)
    [[ -z "$2" ]] && dokku_log_fail "Please specify a main app name"
    MAIN_APP="$2"
    BOUNCER_APP="${MAIN_APP}-pgbouncer"

    dokku config:show "$BOUNCER_APP" || dokku_log_fail "Failed to show config for $BOUNCER_APP. Is pgbouncer set up for this app?"
    ;;

  help | pgbouncer:help)
    help_content_func() {
      declare desc="return pgbouncer plugin help content"
      cat <<EOF
    pgbouncer:intercept-db <app> <service>, Intercept an app's db connection through pgbouncer
    pgbouncer:remove-intercept-db <app> <service>, Remove pgbouncer and restore direct db connection
    pgbouncer:info <app>, Show pgbouncer config for an app
EOF
    }
    if [[ $1 == "pgbouncer:help" ]]; then
      echo -e "Usage: dokku pgbouncer[:COMMAND]"
      echo ""
      echo -e "Manage pgbouncer connection pooling"
      echo ""
      echo -e "Additional commands:"
      help_content_func | sort | column -c2 -t -s,
    else
      help_content_func
    fi
    ;;

  *)
    exit "$DOKKU_NOT_IMPLEMENTED_EXIT"
    ;;
esac
