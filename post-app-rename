#!/usr/bin/env bash
# Dokku calls this at the end of 'apps:rename'.
#
# Every name this plugin uses is derived from the app name: the pgbouncer app
# (<app>-pgbouncer), the shared network (pgbouncer-<app>), and PGBOUNCER_URL's
# host (<app>-pgbouncer.web). A rename leaves all of them pointing at the old
# name. That is harmless in itself — the app keeps working, and disconnect
# follows PGBOUNCER_HOST rather than the naming convention — but the mismatch
# is confusing enough to be worth saying out loud.
#
# Renaming them for real is not safe to do behind the operator's back: it means
# destroying and redeploying the pgbouncer app, which drops every pooled
# connection. So make the mismatch loud instead of silent.
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/functions"

# Argument order has varied across dokku versions; the app that still exists is
# the new one either way.
for candidate in "${1:-}" "${2:-}"; do
  [[ -z "$candidate" ]] && continue
  if dokku apps:exists "$candidate" >/dev/null 2>&1; then
    NEW_APP="$candidate"
  else
    OLD_APP="$candidate"
  fi
done
[[ -z "${OLD_APP:-}" || -z "${NEW_APP:-}" ]] && exit 0

# post-delete consumes the marker as the rename passes through it. Clearing it
# again here covers a rename that failed before reaching the destroy, so a
# later genuine apps:destroy is not silently skipped.
rm -f "$(rename_marker "$OLD_APP")" 2>/dev/null || true

# The old app is gone by now, so the pointer has to be read off the new one.
# PGBOUNCER_HOST came along with the rename and still names the real pgbouncer
# app, whether this is the app's first rename or its third.
BOUNCER_APP=$(resolve_bouncer_app "$NEW_APP")
DB_SERVICE=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_DB_SERVICE 2>/dev/null || true)
[[ -z "$DB_SERVICE" ]] && exit 0
NETWORK_NAME=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_NETWORK 2>/dev/null || true)
[[ -z "$NETWORK_NAME" ]] && NETWORK_NAME="pgbouncer-${OLD_APP}"

dokku_log_warn "$NEW_APP still uses the pgbouncer app '$BOUNCER_APP' and network '$NETWORK_NAME', named after an earlier name of the app."
dokku_log_warn "Pooling keeps working and disconnect still finds them, but to bring the names back in line:"
dokku_log_warn "  dokku pgbouncer:disconnect $NEW_APP"
dokku_log_warn "  dokku pgbouncer:connect $NEW_APP $DB_SERVICE"
exit 0
