#!/usr/bin/env bash
# Dokku calls this early in 'apps:rename', after the new app has been created
# and *before* the old one is destroyed.
#
# That destroy is the whole reason this file exists. 'apps:rename' is
# implemented as create-new + destroy-old, and destroying an app fires the
# post-delete trigger — so without a marker here, renaming an app with pooling
# set up would run this plugin's post-delete for the old name and tear the
# whole setup down: pgbouncer app destroyed, postgres service released, shared
# network removed. The renamed app would keep a PGBOUNCER_URL pointing at a
# host that no longer resolves, and start failing every query on its next
# deploy — which a rename triggers.
#
# The marker is consumed by post-delete. If a rename somehow fails between here
# and the destroy, post-app-rename clears it so a later genuine apps:destroy
# still cleans up.
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/functions"

OLD_APP="${1:-}"
[[ -z "$OLD_APP" ]] && exit 0

# Nothing to protect unless this plugin actually owns a setup for the old name.
# Resolved through PGBOUNCER_HOST rather than derived: an app renamed once
# already has a pgbouncer app named after a name it no longer carries, and
# renaming it again has to leave that setup alone just the same.
BOUNCER_APP=$(resolve_bouncer_app "$OLD_APP")
DB_SERVICE=$(dokku config:get "$BOUNCER_APP" DOKKU_PGBOUNCER_DB_SERVICE 2>/dev/null || true)
[[ -z "$DB_SERVICE" ]] && exit 0

if ! mkdir -p "$PGBOUNCER_DATA_ROOT" 2>/dev/null || ! touch "$(rename_marker "$OLD_APP")" 2>/dev/null; then
  # Never abort the rename over this — dokku treats a non-zero trigger as a
  # failed rename. Say plainly what will happen instead.
  dokku_log_warn "Could not write the pgbouncer rename marker under $PGBOUNCER_DATA_ROOT."
  dokku_log_warn "The rename will tear down the pgbouncer setup of $OLD_APP; re-create it afterwards with: dokku pgbouncer:connect <new-name> $DB_SERVICE"
fi

exit 0
